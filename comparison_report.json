{
  "disclaimer": "ALL DATA IS SIMULATED/SYNTHETIC. Comparison of two detectors on one hand-written simulator; not a measure of real-world performance.",
  "research_question": "Does multi-sensor ML classification provide better accident/event discrimination than a conventional threshold-based detector?",
  "dataset": {
    "csv": "expanded_synthetic_dataset_v2.csv",
    "rows": 40000,
    "n_recordings": 800,
    "samples_per_recording": 50,
    "sample_rate_hz": 10,
    "window_size": 10,
    "stride": 10,
    "split": {
      "level": "recording_id, before windowing (identical to Phase 7)",
      "train_recordings": 640,
      "test_recordings": 160,
      "recording_id_overlap": 0,
      "train_windows": 3200,
      "test_windows": 800
    },
    "test_windows_per_class": {
      "Hard Braking": 100,
      "Minor Accident": 100,
      "Multi-Impact Collision": 100,
      "Normal Driving": 100,
      "Pothole": 100,
      "Rollover": 100,
      "Severe Accident": 100,
      "Sharp Turn": 100
    }
  },
  "binary_definition": {
    "accident": [
      "Minor Accident",
      "Multi-Impact Collision",
      "Rollover",
      "Severe Accident"
    ],
    "non_accident": [
      "Hard Braking",
      "Normal Driving",
      "Pothole",
      "Sharp Turn"
    ],
    "rationale": "An accident is a collision/rollover. Pothole, hard braking and sharp turn are ordinary driving events; flagging them is a false positive. Window labels are inherited from the recording, so pre-event windows of accident recordings count as positives for both detectors."
  },
  "thresholds": {
    "values": {
      "accel_mag_max_g": 1.3020373443704372,
      "gyro_mag_max_dps": 123.49329904893071,
      "vibration_mean": 2.1512749999999996,
      "speed_drop_kmh": 49.77318999999999,
      "turn_gyro_z_range_dps": 5.04805,
      "brake_accel_x_mean_g": -0.036501,
      "pothole_accel_z_range_g": 0.14602999999999988,
      "rollover_dominance_ratio": 2.0,
      "rollover_min_gyro_x_range_dps": 100.0,
      "severe_accel_mag_g": 6.0
    },
    "rules": [
      {
        "rule": "impact_acceleration",
        "description": "peak acceleration magnitude in the window exceeded the threshold",
        "feature": "accel_mag_max",
        "config_field": "accel_mag_max_g",
        "comparison": "strictly greater than"
      },
      {
        "rule": "angular_rate",
        "description": "peak gyroscope magnitude in the window exceeded the threshold",
        "feature": "gyro_mag_max",
        "config_field": "gyro_mag_max_dps",
        "comparison": "strictly greater than"
      },
      {
        "rule": "vibration",
        "description": "mean vibration level in the window exceeded the threshold",
        "feature": "vibration_level_mean",
        "config_field": "vibration_mean",
        "comparison": "strictly greater than"
      },
      {
        "rule": "rapid_deceleration",
        "description": "speed dropped across the window by more than the threshold",
        "feature": "speed_kmh_first_to_last (negated)",
        "config_field": "speed_drop_kmh",
        "comparison": "strictly greater than"
      }
    ],
    "provenance": {
      "method": "accident-gate thresholds = P99 of each rule quantity over TRAINING windows of Normal Driving/Pothole/Hard Braking/Sharp Turn; cascade noise floors = P99 (P1 for the negative-going braking rule) over TRAINING Normal Driving windows; rollover_dominance_ratio, rollover_min_gyro_x_range_dps and severe_accel_mag_g are author-chosen constants. Test set not used.",
